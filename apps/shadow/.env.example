# Ryu Shadow (apps/shadow) — environment configuration
#
# Screen/audio/input capture sidecar (:3030): OCR, proactive engine, semantic
# memory, timeline keyframes, meeting capture. EVERYTHING here is OPTIONAL —
# Shadow ships sensible local defaults and runs on install with none of these set.
#
# Convention: `# NAME=` documents an override you can enable.

# ==============================================================================
# Server / data directory
# ==============================================================================
# HTTP bind port. Default: 3030
# SHADOW_PORT=3030
# Root data directory for indices, clips, and memory DB. Default: ~/.shadow
# SHADOW_DATA_DIR=

# ==============================================================================
# LLM (proactive engine / journal narrator)
# ==============================================================================
# OpenAI-compatible base URL. Default: http://localhost:11434/v1 (Ollama)
# SHADOW_LLM_BASE_URL=http://localhost:11434/v1
# Model id. Default: qwen2.5:7b
# SHADOW_LLM_MODEL=qwen2.5:7b
# Bearer API key — empty for local providers. Default: (empty)
# SHADOW_LLM_API_KEY=

# ==============================================================================
# Passive capture (optional integrations)
# ==============================================================================
# Comma-separated extra filesystem roots to watch (in addition to Desktop/Downloads).
# SHADOW_FS_WATCH=
# Comma-separated git repo paths for passive commit events (plus auto-discovered repos).
# SHADOW_GIT_REPOS=
# Path or URL to an iCalendar (.ics) file for calendar-aware capture.
# SHADOW_CALENDAR_ICS=

# ==============================================================================
# Clips / keyframes (Core transcription egress)
# ==============================================================================
# Core base URL for clip transcription (loopback-only SSRF guard). Default:
# http://127.0.0.1:7980
# RYU_CORE_URL=http://127.0.0.1:7980
# Clip screen-capture FPS override.
# SHADOW_CLIP_FPS=
# Keyframe extraction tunables (see apps/shadow/src/capture/frames.rs).
# RYU_CLIP_FRAME_WIDTH=
# RYU_CLIP_EFFICIENT_FRAMES=
# RYU_CLIP_SCENE_THRESHOLD=
# RYU_CLIP_DEDUP_DELTA=
# RYU_CLIP_BALANCED_CAP=
